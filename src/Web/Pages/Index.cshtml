@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="dashboard__content-wrapper d-flex flex-column px-4 py-3">
    @await Html.PartialAsync("_Navbar")

    <div class="metric-card-wrapper d-flex gap-3">
        @await Html.PartialAsync("_Card")
        @await Html.PartialAsync("_Card")
        @await Html.PartialAsync("_Card")
        @await Html.PartialAsync("_Card")
    </div>

    <div class="chart-and-action-panel-wrapper d-flex justify-content-between d-flex">
        @await Html.PartialAsync("_Chart")
        @await Html.PartialAsync("_Menu")
    </div>
</div>

<style>
    .dashboard__content-wrapper {
        gap: 30px;
    }
</style>